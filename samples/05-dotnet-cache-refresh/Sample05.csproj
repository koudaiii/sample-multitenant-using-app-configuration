<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>MtAppConfig.CacheRefresh</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.AzureAppConfiguration" Version="8.4.0" />
    <PackageReference Include="Azure.Identity" Version="1.14.0" />
  </ItemGroup>

  <!--
    Without this, the default `**/*.cs` compile glob recurses into Tests/,
    which has its own project file — the .NET SDK does not automatically
    exclude subdirectories that contain another project. That causes
    Sample05.csproj to try to compile the xunit test file itself and fail
    (Xunit types not referenced here), instead of the Tests project.
  -->
  <ItemGroup>
    <Compile Remove="Tests/**/*.cs" />
  </ItemGroup>

</Project>
